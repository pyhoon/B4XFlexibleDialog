{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b4xflexibledialog.local/schema/definition-v1.json",
  "title": "B4XFlexibleDialog preference definition, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "titleKey": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preferences"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "titleKey": {"type": "string", "minLength": 1},
        "preferences": {"type": "array", "items": {"$ref": "#/$defs/preference"}}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "titleKey"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["text", "multiline", "password", "number", "switch", "checkbox", "choice", "multichoice", "date", "slider", "time", "datetime", "label", "action"]},
        "titleKey": {"type": "string", "minLength": 1},
        "descriptionKey": {"type": "string"},
        "defaultValue": {},
        "options": {"type": "object"},
        "required": {"type": "boolean"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["text", "multiline", "password"]}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "number"}}, "required": ["type"]}, "then": {"properties": {
          "defaultValue": {"type": "number"},
          "options": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}
        }}},
        {"if": {"properties": {"type": {"const": "slider"}}, "required": ["type"]}, "then": {"properties": {
          "defaultValue": {"type": "number"},
          "options": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}
        }}},
        {"if": {"properties": {"type": {"const": "date"}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}},
        {"if": {"properties": {"type": {"const": "time"}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "string", "pattern": "^$|^([01][0-9]|2[0-3]):[0-5][0-9]$"}}}},
        {"if": {"properties": {"type": {"const": "datetime"}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]$"}}}},
        {"if": {"properties": {"type": {"enum": ["switch", "checkbox"]}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "choice"}}, "required": ["type"]}, "then": {
          "required": ["defaultValue", "options"],
          "properties": {"defaultValue": {"type": "string"}, "options": {
            "type": "object", "additionalProperties": false, "required": ["items"],
            "properties": {"items": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["value", "titleKey"],
              "properties": {"value": {"type": "string"}, "titleKey": {"type": "string", "minLength": 1}}
            }}}
          }}
        }}
        ,{"if": {"properties": {"type": {"const": "multichoice"}}, "required": ["type"]}, "then": {
          "required": ["options"],
          "properties": {"defaultValue": {"type": "array", "items": {"type": "string"}}, "options": {
            "type": "object", "additionalProperties": false, "required": ["items"],
            "properties": {"items": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["value", "titleKey"],
              "properties": {"value": {"type": "string"}, "titleKey": {"type": "string", "minLength": 1}}
            }}}
          }}
        }}
      ]
    }
  }
}
