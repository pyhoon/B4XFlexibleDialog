{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b4xflexibledialog.local/schema/definition-v1.json",
  "title": "B4XFlexibleDialog preference definition, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sections"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "titleKey": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preferences"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "titleKey": {"type": "string", "minLength": 1},
        "preferences": {"type": "array", "items": {"$ref": "#/$defs/preference"}}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "titleKey"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["text", "number", "switch", "choice"]},
        "titleKey": {"type": "string", "minLength": 1},
        "defaultValue": {},
        "options": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "number"}}, "required": ["type"]}, "then": {"properties": {
          "defaultValue": {"type": "number"},
          "options": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}
        }}},
        {"if": {"properties": {"type": {"const": "switch"}}, "required": ["type"]}, "then": {"properties": {"defaultValue": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "choice"}}, "required": ["type"]}, "then": {
          "required": ["defaultValue", "options"],
          "properties": {"defaultValue": {"type": "string"}, "options": {
            "type": "object", "additionalProperties": false, "required": ["items"],
            "properties": {"items": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["value", "titleKey"],
              "properties": {"value": {"type": "string"}, "titleKey": {"type": "string", "minLength": 1}}
            }}}
          }}
        }}
      ]
    }
  }
}
