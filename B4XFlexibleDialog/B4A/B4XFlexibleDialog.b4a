' B4A validation and renderer demo for B4XFlexibleDialog.
' Runs the platform-independent PrefsSelfTest at startup, then offers a
' rendered preferences form (text, number, switch, choice and more) with
' Save/Cancel backed by the shared PrefsController.

Sub Process_Globals
	Private FormOpen As Boolean
End Sub

Sub Globals
	Private ResultsLabel As Label
	Private OpenButton As Button
	Private Model As PrefsModel
	Private Controller As PrefsController
	Private Localization As PrefsLocalization
	Private Renderer As PrefsRenderer
	Private DirPicker As PrefsDirPicker
	Private StarFont As Typeface
	Private Store As PrefsStore
	Private StoreFileName As String = "prefs-values.json"
	Private HostPanel As Panel
	Private SaveButton As Button
	Private CancelButton As Button
End Sub

Sub Activity_Create(FirstTime As Boolean)
	ResultsLabel.Initialize("")
	Activity.AddView(ResultsLabel, 10dip, 10dip, 100%x - 20dip, 100%y - 140dip)
	OpenButton.Initialize("OpenButton")
	OpenButton.Text = "Open preferences"
	Activity.AddView(OpenButton, 10dip, 100%y - 120dip, 100%x - 20dip, 60dip)
	Dim SelfTest As PrefsSelfTest
	SelfTest.Initialize
	Dim Outcome As Map = SelfTest.RunAll
	Dim Passed As Int = Outcome.Get("passed")
	Dim Failed As Int = Outcome.Get("failed")
	Dim Report As String = "passed=" & Passed & " failed=" & Failed & CRLF & CRLF & Outcome.Get("log")
	ResultsLabel.Text = Report
	Log(Report)
	LoadDefinition
	FormOpen = False
End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)
	
End Sub

Private Sub LoadDefinition
	Dim EnDict As Map
	EnDict.Initialize
	EnDict.Put("settings.title", "Settings")
	EnDict.Put("section.general", "General")
	EnDict.Put("setting.username", "Username")
	EnDict.Put("setting.items_per_page", "Items per page")
	EnDict.Put("setting.dark_mode", "Dark mode")
	EnDict.Put("setting.show_tips", "Show tips")
	EnDict.Put("setting.display_mode", "Display mode")
	EnDict.Put("display.compact", "Compact")
	EnDict.Put("display.comfortable", "Comfortable")
	EnDict.Put("setting.about", "About")
	EnDict.Put("setting.api_key", "API key")
	EnDict.Put("setting.notifications", "Notifications")
	EnDict.Put("notification.email", "Email")
	EnDict.Put("notification.push", "Push")
	EnDict.Put("notification.weekly", "Weekly summary")
	EnDict.Put("setting.font_scale", "Font scale")
	EnDict.Put("setting.company_logo", "Company logo")
	EnDict.Put("setting.satisfaction", "Satisfaction")
	EnDict.Put("setting.export_folder", "Export folder")
	EnDict.Put("ui.browse", "Browse")
	EnDict.Put("setting.account_note", "Account information")
	EnDict.Put("setting.account_note_description", "Changes are kept in memory only.")
	EnDict.Put("setting.clear_cache", "Clear temporary cache")
	Localization.Initialize
	Localization.SetDictionary("en", EnDict)
	Localization.SetLanguage("en")
	Model.Initialize
	If Model.LoadFromJson(DemoDefinition) = False Then
		Log("Definition error: " & Model.LastError)
		Return
	End If
	Controller.Initialize(Model)
	Renderer.Initialize(Me, "Prefs", Model, Controller, Localization)
	Renderer.RegisterCustomRenderer("RatingStars", Me, "Rating")
	DirPicker.Initialize(Me, "DirPicker")
	Store.Initialize
	If File.Exists(File.DirInternal, StoreFileName) Then
		If Store.FromJson(File.ReadString(File.DirInternal, StoreFileName)) Then
			Dim Restored As Int = Controller.ApplyValues(Store.Load)
			Log("Restored " & Restored & " value(s) from " & StoreFileName)
		Else
			Log("Stored values file could not be parsed: " & StoreFileName)
		End If
	End If
End Sub

Private Sub DemoDefinition As String
	Return "{""schemaVersion"":1,""id"":""demo.settings"",""titleKey"":""settings.title"",""sections"":[{""id"":""general"",""titleKey"":""section.general"",""preferences"":[{""id"":""username"",""type"":""text"",""titleKey"":""setting.username"",""defaultValue"":""Guest"",""required"":true,""minLength"":3,""maxLength"":32},{""id"":""about"",""type"":""multiline"",""titleKey"":""setting.about"",""defaultValue"":"""",""maxLength"":120},{""id"":""api_key"",""type"":""password"",""titleKey"":""setting.api_key"",""defaultValue"":""""},{""id"":""items_per_page"",""type"":""number"",""titleKey"":""setting.items_per_page"",""defaultValue"":20,""options"":{""min"":5,""max"":200}},{""id"":""dark_mode"",""type"":""switch"",""titleKey"":""setting.dark_mode"",""defaultValue"":false},{""id"":""show_tips"",""type"":""checkbox"",""titleKey"":""setting.show_tips"",""defaultValue"":true},{""id"":""display_mode"",""type"":""choice"",""titleKey"":""setting.display_mode"",""defaultValue"":""compact"",""options"":{""items"":[{""value"":""compact"",""titleKey"":""display.compact""},{""value"":""comfortable"",""titleKey"":""display.comfortable""}]}},{""id"":""notifications"",""type"":""multichoice"",""titleKey"":""setting.notifications"",""defaultValue"":[""email""],""options"":{""items"":[{""value"":""email"",""titleKey"":""notification.email""},{""value"":""push"",""titleKey"":""notification.push""},{""value"":""weekly"",""titleKey"":""notification.weekly""}]}},{""id"":""font_scale"",""type"":""slider"",""titleKey"":""setting.font_scale"",""defaultValue"":1.0,""options"":{""min"":0.8,""max"":1.4}},{""id"":""company_logo"",""type"":""file"",""titleKey"":""setting.company_logo"",""defaultValue"":"""",""options"":{""extensions"":[""png"",""jpg"",""jpeg"",""webp""],""allowClear"":true,""copyToAppStorage"":true}},{""id"":""export_folder"",""type"":""directory"",""titleKey"":""setting.export_folder"",""defaultValue"":"""",""options"":{""allowClear"":true}},{""id"":""satisfaction"",""type"":""custom"",""titleKey"":""setting.satisfaction"",""defaultValue"":3,""options"":{""renderer"":""RatingStars"",""height"":56}},{""id"":""account_note"",""type"":""label"",""titleKey"":""setting.account_note"",""descriptionKey"":""setting.account_note_description""},{""id"":""clear_cache"",""type"":""action"",""titleKey"":""setting.clear_cache""}]}]}"
End Sub

Sub OpenButton_Click
	If FormOpen Then Return
	FormOpen = True
	HostPanel.Initialize("")
	HostPanel.Color = Colors.White
	Activity.AddView(HostPanel, 0, 0, 100%x, 100%y - 140dip)
	Renderer.Render(HostPanel)
	SaveButton.Initialize("SaveButton")
	SaveButton.Text = "Save"
	Activity.AddView(SaveButton, 10dip, 100%y - 130dip, (100%x - 30dip) / 2, 60dip)
	CancelButton.Initialize("CancelButton")
	CancelButton.Text = "Cancel"
	Activity.AddView(CancelButton, 20dip + (100%x - 30dip) / 2, 100%y - 130dip, (100%x - 30dip) / 2, 60dip)
	OpenButton.Visible = False
End Sub

Sub SaveButton_Click
	If Renderer.Save Then
		CloseForm
	Else
		Log("Save blocked by validation")
	End If
End Sub

Sub CancelButton_Click
	Renderer.Cancel
	CloseForm
End Sub

Private Sub CloseForm
	FormOpen = False
	Renderer.Dispose
	HostPanel.RemoveView
	SaveButton.RemoveView
	CancelButton.RemoveView
	OpenButton.Visible = True
End Sub

Sub Prefs_BeforeSave(Values As Map) As Boolean
	Return True
End Sub

Sub Prefs_AfterSave(Values As Map)
	Log("Saved values: " & Values)
	Store.Save(Values)
	File.WriteString(File.DirInternal, StoreFileName, Store.ToJson)
End Sub

Sub Prefs_Action(PreferenceId As String)
	Log("Action: " & PreferenceId)
End Sub

Sub Prefs_BrowseDirectory(Id As String)
	DirPicker.SelectDir(False)
End Sub

Sub DirPicker_DirectoryPicked(Uri As String)
	Log("Picked directory: " & Uri)
	Renderer.SetDirectoryValue(Uri)
End Sub

Sub DirPicker_DirectoryCancelled
	Log("Directory pick cancelled")
End Sub

' Sample custom renderer: a 1-5 rating row. Follows the same lifecycle
' contract as B4J (create/read/validate/refresh/dispose); B4A invokes
' create/read/validate/dispose, and re-render replaces refresh.
Private Sub Rating_Create(Args As Map) As Object
	Dim Parent As B4XView = Args.Get("parent")
	Dim Left As Int = Args.Get("left")
	Dim Top As Int = Args.Get("top")
	Dim Width As Int = Args.Get("width")
	Dim Height As Int = Args.Get("height")
	Dim Value As Int = Args.Get("value")
	Dim Buttons As List
	Buttons.Initialize
	Dim Handle As Map
	Handle.Initialize
	Handle.Put("buttons", Buttons)
	Handle.Put("value", Value)
	If StarFont.IsInitialized = False Then StarFont = Typeface.LoadFromAssets("b4x_materialicons.ttf")
	Dim StarWidth As Int = Width / 5
	For I = 1 To 5
		Dim Star As Label
		Star.Initialize("ratingStar")
		Dim Tag As Map
		Tag.Initialize
		Tag.Put("handle", Handle)
		Tag.Put("index", I)
		Star.Tag = Tag
		Star.Typeface = StarFont
		Star.TextSize = 30
		Star.Gravity = Gravity.CENTER
		Parent.AddView(Star, Left + (I - 1) * StarWidth, Top, StarWidth, Height)
		Buttons.Add(Star)
	Next
	Rating_Paint(Handle)
	Return Handle
End Sub

Private Sub Rating_Read(Handle As Object, Definition As Map) As Object
	Dim H As Map = Handle
	Return H.Get("value")
End Sub

Private Sub Rating_Validate(Value As Object, Definition As Map) As String
	Try
		Dim RatingValue As Int = Value
		If RatingValue >= 1 And RatingValue <= 5 Then Return ""
	Catch
		Log(LastException.Message)
	End Try
	Return "Rating must be between 1 and 5"
End Sub

Private Sub Rating_Refresh(Handle As Object, Args As Map)
	Dim H As Map = Handle
	H.Put("value", Args.Get("value"))
	Rating_Paint(H)
End Sub

Private Sub Rating_Dispose(Handle As Object)
	Dim H As Map = Handle
	Dim Buttons As List = H.Get("buttons")
	For Each StarObject As Object In Buttons
		Dim Star As B4XView = StarObject
		Star.RemoveViewFromParent
	Next
End Sub

' Selection is shown with filled versus outline star glyphs tinted gold and
' gray, so the control needs no theme-specific colors.
Private Sub Rating_Paint(Handle As Map)
	Dim Buttons As List = Handle.Get("buttons")
	Dim Value As Int = Handle.Get("value")
	For I = 0 To Buttons.Size - 1
		Dim Star As Label = Buttons.Get(I)
		If I < Value Then
			Star.Text = Chr(0xE838)
			Star.TextColor = Colors.RGB(255, 193, 7)
		Else
			Star.Text = Chr(0xE83A)
			Star.TextColor = Colors.Gray
		End If
	Next
End Sub

Private Sub ratingStar_Click
	Dim Star As Label = Sender
	Dim Tag As Map = Star.Tag
	Dim Handle As Map = Tag.Get("handle")
	Handle.Put("value", Tag.Get("index"))
	Rating_Paint(Handle)
End Sub
