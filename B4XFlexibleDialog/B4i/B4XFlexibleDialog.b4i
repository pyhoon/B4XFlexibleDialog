'Code module
#Region  Project Attributes
	#ApplicationLabel: B4XFlexibleDialog
	#Version: 1.0.0
	#iPhoneOrientations: Portrait, LandscapeLeft, LandscapeRight
	#iPadOrientations: Portrait, LandscapeLeft, LandscapeRight, PortraitUpsideDown
	#Target: iPhone, iPad
	#ATSEnabled: True
	#MinVersion: 8
#End Region

' Shared-module validation for B4XFlexibleDialog.
' Runs the platform-independent PrefsSelfTest at startup and shows the results.
' No UI renderer is implemented on B4i yet.
' NOTE: B4i compilation requires a Mac builder and has not been verified locally.

Sub Process_Globals
	Public App As Application
	Public NavControl As NavigationController
	Private MainPage As Page
End Sub

Private Sub Application_Start (Nav As NavigationController)
	NavControl = Nav
	MainPage.Initialize("MainPage")
	MainPage.Title = "B4XFlexibleDialog"
	NavControl.ShowPage(MainPage)
	Dim ResultsLabel As Label
	ResultsLabel.Initialize("Results")
	ResultsLabel.Multiline = True
	MainPage.RootPanel.AddView(ResultsLabel, 10, 10, 100%x - 20, 100%y - 20)
	Dim SelfTest As PrefsSelfTest
	SelfTest.Initialize
	Dim Outcome As Map = SelfTest.RunAll
	Dim Passed As Int = Outcome.Get("passed")
	Dim Failed As Int = Outcome.Get("failed")
	Dim Report As String = "passed=" & Passed & " failed=" & Failed & CRLF & CRLF & Outcome.Get("log")
	ResultsLabel.Text = Report
	Log(Report)
End Sub

Private Sub MainPage_Resize (Width As Int, Height As Int)
End Sub
